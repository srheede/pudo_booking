rules_version = '2';
// Rules for the pudo-booking (INTERNAL) Firebase project.
// The public subscription project (pudo-booking-pub) has its own rules in
// the pudo_booking_homepage repo.
service cloud.firestore {
  match /databases/{database}/documents {

    // Flat collections shared by all authenticated users.
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    match /sender/{senderId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
